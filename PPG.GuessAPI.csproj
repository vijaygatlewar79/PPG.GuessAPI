  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PPG.GuessData\**\*.cs" />
    <ProjectReference Include="PPG.GuessData\PPG.GuessData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="chart-sources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Files\**\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Files\**\*.xlsm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
